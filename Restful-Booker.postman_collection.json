        "body": {
          "mode": "raw",
          "raw": "{\"totalprice\": 250}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Partial update changes only the given fields."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Only the price changed', () => {",
              "  pm.expect(j.totalprice).to.eql(250);",
              "  pm.expect(j.firstname).to.eql('Mohamed');",
              "  pm.expect(j.additionalneeds).to.eql('Late checkout');",
              "});"
            ]
          }
        }
      ]
    },
